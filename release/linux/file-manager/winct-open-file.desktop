# Dolphin service menu, installed to /usr/share/kio/servicemenus. Text files only: most code and
# configuration types are subclasses of text/plain, and service menus match subclasses.
[Desktop Entry]
Type=Service
MimeType=text/plain;
Actions=openWithWinct;
X-KDE-Priority=TopLevel

[Desktop Action openWithWinct]
Name=Open with Winct
Name[zh_CN]=通过 Winct 打开
Icon=winct
Exec=winct %F
