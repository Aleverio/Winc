<?xml version="1.0" encoding="utf-8"?>
<!-- Types winct can open, listed under Applications\winct.exe\SupportedTypes: winct appears in
     "Open with" > "Choose another app" for them. Nothing is written under the types themselves
     unless the optional FileTypes feature is installed, so Windows keeps their default program and
     icon and does not ask which program to use. Keep this
     list the same as ForEachFileType in installer.nsi. The types are grouped by the document
     icon they show (release/windows/icons); FileTypes is all of them.
     Registry keys ignore case; upper case gives the "JSON File" name the shell shows for a type. -->
<?define MarkdownTypes = MARKDOWN;MD;MDOWN;MKD;MKDN?>
<?define JsonTypes = GEOJSON;JSON;JSON5;JSONC;JSONL;NDJSON;WEBMANIFEST?>
<?define ConfigTypes = CFG;CONF;DESKTOP;DOCKERFILE;ENV;INF;INI;PROPERTIES;SERVICE;TOML;YAML;YML?>
<?define MarkupTypes = ASTRO;ATOM;CLS;CSPROJ;DTX;FSPROJ;HTM;HTML;KML;LIQUID;LTX;NJK;NUNJUCKS;NUSPEC;PLIST;PROPS;RESX;RSS;STORYBOARD;STY;SVELTE;SVG;TARGETS;TEX;VBPROJ;VCXPROJ;VUE;WSDL;WXML;XAML;XCSCHEME;XHTML;XIB;XML;XSD;XSL;XSLT?>
<?define StyleTypes = CSS;LESS;SASS;SCSS;WXSS?>
<?define ScriptTypes = ASH;BASH;FISH;KSH;MK;PS1;PSD1;PSM1;SH;ZSH?>
<?define TableTypes = CSV;TAB;TSV?>
<?define TextTypes = DIFF;EPUB;LOG;PATCH;PDF;TXT?>
<?define JavascriptTypes = CJS;JS;JSX;MJS?>
<?define TypescriptTypes = CTS;MTS;TS;TSX?>
<?define PythonTypes = BZL;PY;PYI;STAR?>
<?define RustTypes = RS?>
<?define GoTypes = GO?>
<?define CTypes = C;CC;CPP;CPPM;CU;CUH;CXX;H;HH;HPP;HXX;INL;INO;IPP;IXX;TPP?>
<?define ProjectTypes = CODE-WORKSPACE;IPR;SUBLIME-PROJECT;WINCT-PROJECT?>
<?define CodeTypes = BB;CLJ;CLJC;CLJS;CMAKE;CS;CSX;DART;EDN;ERL;ESCRIPT;ETS;EX;EXS;FS;FSI;FSX;GEMSPEC;GQL;GRADLE;GRAPHQL;GRAPHQLS;GROOVY;HCL;HRL;HS;HSC;HTTP;JAVA;JBUILDER;JL;KT;KTS;LUA;LUAU;M;ML;MLI;MLL;MLY;MM;NIX;NOMAD;PHP;PHP3;PHP4;PHP5;PHP8;PHPS;PHTML;PL;PM;POD;PODSPEC;PROTO;PSGI;R;RAKE;RB;RBI;REST;ROCKSPEC;RPROFILE;SC;SCALA;SQL;SWIFT;T;TF;TFTEST;TFVARS;WXS;ZIG;ZON?>
<?define IconNames = markdown;json;config;markup;style;script;table;text;javascript;typescript;python;rust;go;c;code;project;file?>
<?define FileTypes = $(var.MarkdownTypes);$(var.JsonTypes);$(var.ConfigTypes);$(var.MarkupTypes);$(var.StyleTypes);$(var.ScriptTypes);$(var.TableTypes);$(var.TextTypes);$(var.JavascriptTypes);$(var.TypescriptTypes);$(var.PythonTypes);$(var.RustTypes);$(var.GoTypes);$(var.CTypes);$(var.CodeTypes);$(var.ProjectTypes)?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <!-- UUIDv5(DNS, com.deeix.winct); keep this product family stable across releases. -->
  <Product Id="*" Name="Winct" Language="1033" Version="$(var.Version)" Manufacturer="DEEIX"
           UpgradeCode="00FDC6A5-D527-59AE-B4A5-E051B25222F3">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64"/>
    <MajorUpgrade AllowDowngrades="yes" Schedule="afterInstallInitialize"/>
    <Property Id="REINSTALLMODE" Value="amus"/>
    <MediaTemplate EmbedCab="yes"/>
    <Icon Id="WinctIcon" SourceFile="$(var.Source)\winct.ico"/>
    <Property Id="ARPPRODUCTICON" Value="WinctIcon"/>
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER"/>
    <WixVariable Id="WixUILicenseRtf" Value="$(var.Source)\license.rtf"/>
    <UIRef Id="WixUI_InstallDir"/>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="winct">
          <Component Id="Application" Guid="*" Win64="yes">
            <File Id="WinctExe" Source="$(var.Source)\winct.exe" KeyPath="yes"/>
          </Component>
          <Component Id="TerminalHelper" Guid="*" Win64="yes">
            <File Source="$(var.Source)\winct-pty.exe" KeyPath="yes"/>
          </Component>
          <Component Id="ConptyLibrary" Guid="*" Win64="yes">
            <File Source="$(var.Source)\conpty.dll" KeyPath="yes"/>
          </Component>
          <Component Id="ConsoleHost" Guid="*" Win64="yes">
            <File Source="$(var.Source)\OpenConsole.exe" KeyPath="yes"/>
          </Component>
          <Component Id="WslWatcher" Guid="*" Win64="yes">
            <File Id="WinctWatch" Source="$(var.Source)\winct-watch" KeyPath="yes"/>
          </Component>
          <Component Id="RemoteServerX64" Guid="*" Win64="yes">
            <File Id="WinctServerX64" Source="$(var.Source)\winct-server-Linux-x86_64" KeyPath="yes"/>
          </Component>
          <Component Id="RemoteServerArm64" Guid="*" Win64="yes">
            <File Id="WinctServerArm64" Source="$(var.Source)\winct-server-Linux-aarch64" KeyPath="yes"/>
          </Component>
          <Component Id="InstallationKind" Guid="*" Win64="yes">
            <File Source="$(var.Source)\msi\winct-installation" KeyPath="yes"/>
          </Component>
          <Component Id="FileAssociations" Guid="*" Win64="yes">
            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\winct.exe" Name="FriendlyAppName" Value="Winct" Type="string" KeyPath="yes"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\winct.exe\DefaultIcon" Value="[#WinctExe],0" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\winct.exe\shell\open\command" Value="&quot;[#WinctExe]&quot; &quot;%1&quot;" Type="string"/>
            <!-- The shell reads only the value names of SupportedTypes. An empty value means Null to
                 Windows Installer, so these hold a placeholder. The winct.<type> ProgID is not listed
                 under any type; it stays for users who chose winct as the default program while
                 earlier versions listed it, whose choice names this ProgID. -->
            <?foreach Type in $(var.FileTypes)?>
            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\winct.exe\SupportedTypes" Name=".$(var.Type)" Value="winct" Type="string"/>
            <?endforeach?>
            <!-- Each ProgID carries its type's document icon. Explorer shows it for a type whose
                 chosen program is this ProgID; a choice made through "Open with" names winct.exe
                 instead and shows its icon. -->
            <?foreach Type in $(var.MarkdownTypes)?>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)" Value="$(var.Type) File" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)\DefaultIcon" Value="[#Icon_markdown]" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)\shell\open\command" Value="&quot;[#WinctExe]&quot; &quot;%1&quot;" Type="string"/>
            <?endforeach?>
            <?foreach Type in $(var.JsonTypes)?>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)" Value="$(var.Type) File" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)\DefaultIcon" Value="[#Icon_json]" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)\shell\open\command" Value="&quot;[#WinctExe]&quot; &quot;%1&quot;" Type="string"/>
            <?endforeach?>
            <?foreach Type in $(var.ConfigTypes)?>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)" Value="$(var.Type) File" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)\DefaultIcon" Value="[#Icon_config]" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)\shell\open\command" Value="&quot;[#WinctExe]&quot; &quot;%1&quot;" Type="string"/>
            <?endforeach?>
            <?foreach Type in $(var.MarkupTypes)?>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)" Value="$(var.Type) File" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)\DefaultIcon" Value="[#Icon_markup]" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)\shell\open\command" Value="&quot;[#WinctExe]&quot; &quot;%1&quot;" Type="string"/>
            <?endforeach?>
            <?foreach Type in $(var.StyleTypes)?>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)" Value="$(var.Type) File" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)\DefaultIcon" Value="[#Icon_style]" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)\shell\open\command" Value="&quot;[#WinctExe]&quot; &quot;%1&quot;" Type="string"/>
            <?endforeach?>
            <?foreach Type in $(var.ScriptTypes)?>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)" Value="$(var.Type) File" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)\DefaultIcon" Value="[#Icon_script]" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)\shell\open\command" Value="&quot;[#WinctExe]&quot; &quot;%1&quot;" Type="string"/>
            <?endforeach?>
            <?foreach Type in $(var.TableTypes)?>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)" Value="$(var.Type) File" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)\DefaultIcon" Value="[#Icon_table]" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)\shell\open\command" Value="&quot;[#WinctExe]&quot; &quot;%1&quot;" Type="string"/>
            <?endforeach?>
            <?foreach Type in $(var.TextTypes)?>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)" Value="$(var.Type) File" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)\DefaultIcon" Value="[#Icon_text]" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)\shell\open\command" Value="&quot;[#WinctExe]&quot; &quot;%1&quot;" Type="string"/>
            <?endforeach?>
            <?foreach Type in $(var.JavascriptTypes)?>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)" Value="$(var.Type) File" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)\DefaultIcon" Value="[#Icon_javascript]" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)\shell\open\command" Value="&quot;[#WinctExe]&quot; &quot;%1&quot;" Type="string"/>
            <?endforeach?>
            <?foreach Type in $(var.TypescriptTypes)?>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)" Value="$(var.Type) File" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)\DefaultIcon" Value="[#Icon_typescript]" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)\shell\open\command" Value="&quot;[#WinctExe]&quot; &quot;%1&quot;" Type="string"/>
            <?endforeach?>
            <?foreach Type in $(var.PythonTypes)?>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)" Value="$(var.Type) File" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)\DefaultIcon" Value="[#Icon_python]" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)\shell\open\command" Value="&quot;[#WinctExe]&quot; &quot;%1&quot;" Type="string"/>
            <?endforeach?>
            <?foreach Type in $(var.RustTypes)?>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)" Value="$(var.Type) File" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)\DefaultIcon" Value="[#Icon_rust]" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)\shell\open\command" Value="&quot;[#WinctExe]&quot; &quot;%1&quot;" Type="string"/>
            <?endforeach?>
            <?foreach Type in $(var.GoTypes)?>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)" Value="$(var.Type) File" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)\DefaultIcon" Value="[#Icon_go]" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)\shell\open\command" Value="&quot;[#WinctExe]&quot; &quot;%1&quot;" Type="string"/>
            <?endforeach?>
            <?foreach Type in $(var.CTypes)?>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)" Value="$(var.Type) File" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)\DefaultIcon" Value="[#Icon_c]" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)\shell\open\command" Value="&quot;[#WinctExe]&quot; &quot;%1&quot;" Type="string"/>
            <?endforeach?>
            <?foreach Type in $(var.CodeTypes)?>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)" Value="$(var.Type) File" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)\DefaultIcon" Value="[#Icon_code]" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)\shell\open\command" Value="&quot;[#WinctExe]&quot; &quot;%1&quot;" Type="string"/>
            <?endforeach?>
            <?foreach Type in $(var.ProjectTypes)?>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)" Value="$(var.Type) File" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)\DefaultIcon" Value="[#Icon_project]" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct.$(var.Type)\shell\open\command" Value="&quot;[#WinctExe]&quot; &quot;%1&quot;" Type="string"/>
            <?endforeach?>
          </Component>
          <!-- Optional, on by default: lists the ProgIDs under the types. A handler listed there
               makes Windows ask once which program to use. Install with ADDLOCAL=Main to leave it
               out; an upgrade keeps the earlier choice. -->
          <Component Id="FileTypeListing" Guid="*" Win64="yes">
            <RegistryValue Root="HKLM" Key="Software\DEEIX\winct\MSI" Name="File Types" Type="integer" Value="1" KeyPath="yes"/>
            <!-- The shell reads only the value names; the data is a placeholder, as above. -->
            <?foreach Type in $(var.FileTypes)?>
            <RegistryValue Root="HKLM" Key="Software\Classes\.$(var.Type)\OpenWithProgids" Name="winct.$(var.Type)" Value="winct" Type="string"/>
            <?endforeach?>
          </Component>
          <Directory Id="ICONSFOLDER" Name="icons">
            <?foreach Icon in $(var.IconNames)?>
            <Component Id="Icon_$(var.Icon)" Guid="*" Win64="yes">
              <File Id="Icon_$(var.Icon)" Source="$(var.Source)\icons\$(var.Icon).ico" KeyPath="yes"/>
            </Component>
            <?endforeach?>
          </Directory>
          <!-- Explorer context menu: "Open with Winct" on the supported types, added under
               SystemFileAssociations so their default program stays unchanged, and "Open in Winct" on
               a folder and on the empty space inside one (also the desktop), where %V is that folder.
               Windows 11 shows these under "Show more options". -->
          <Component Id="ContextMenu" Guid="*" Win64="yes">
            <RegistryValue Root="HKLM" Key="Software\Classes\Directory\shell\winct" Value="Open in Winct" Type="string" KeyPath="yes"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Directory\shell\winct" Name="Icon" Value="[#WinctExe],0" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Directory\shell\winct\command" Value="&quot;[#WinctExe]&quot; &quot;%V&quot;" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Directory\Background\shell\winct" Value="Open in Winct" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Directory\Background\shell\winct" Name="Icon" Value="[#WinctExe],0" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Directory\Background\shell\winct\command" Value="&quot;[#WinctExe]&quot; &quot;%V&quot;" Type="string"/>
            <?foreach Type in $(var.FileTypes)?>
            <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.$(var.Type)\shell\winct" Value="Open with Winct" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.$(var.Type)\shell\winct" Name="Icon" Value="[#WinctExe],0" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.$(var.Type)\shell\winct\command" Value="&quot;[#WinctExe]&quot; &quot;%1&quot;" Type="string"/>
            <?endforeach?>
          </Component>
          <!-- The winct: URL scheme: winct://file/<absolute path>[:line[:column]] opens a file or
               folder in winct, which receives the whole link as its argument. The shell checks only
               that "URL Protocol" exists; an empty value means Null to Windows Installer, so it
               holds a placeholder. -->
          <Component Id="UrlScheme" Guid="*" Win64="yes">
            <RegistryValue Root="HKLM" Key="Software\Classes\winct" Value="URL:Winct" Type="string" KeyPath="yes"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct" Name="URL Protocol" Value="winct" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct\DefaultIcon" Value="[#WinctExe],0" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winct\shell\open\command" Value="&quot;[#WinctExe]&quot; &quot;%1&quot;" Type="string"/>
          </Component>
          <Directory Id="BINFOLDER" Name="bin">
            <Component Id="CommandLine" Guid="*" Win64="yes">
              <File Id="WinctLauncher" Source="$(var.Source)\bin\winct" KeyPath="yes"/>
              <Environment Id="WinctPath" Name="PATH" Value="[BINFOLDER]" Action="set" Part="last" System="yes" Permanent="no"/>
            </Component>
            <Component Id="CommandLineCmd" Guid="*" Win64="yes">
              <File Id="WinctLauncherCmd" Source="$(var.Source)\bin\winct.cmd" KeyPath="yes"/>
            </Component>
          </Directory>
          <Component Id="License" Guid="*" Win64="yes"><File Source="$(var.Source)\LICENSE" KeyPath="yes"/></Component>
          <Component Id="Notice" Guid="*" Win64="yes"><File Source="$(var.Source)\NOTICE" KeyPath="yes"/></Component>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Winct">
          <Component Id="StartMenu" Guid="*" Win64="yes">
            <Shortcut Id="StartMenuShortcut" Name="Winct" Target="[#WinctExe]" WorkingDirectory="INSTALLFOLDER" Icon="WinctIcon"/>
            <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall"/>
            <RegistryValue Root="HKCU" Key="Software\DEEIX\winct\MSI" Name="Start Menu Shortcut" Type="integer" Value="1" KeyPath="yes"/>
          </Component>
        </Directory>
      </Directory>
    </Directory>
    <Feature Id="Main" Title="winct" Level="1">
      <ComponentRef Id="Application"/><ComponentRef Id="TerminalHelper"/><ComponentRef Id="InstallationKind"/>
      <ComponentRef Id="ConptyLibrary"/><ComponentRef Id="ConsoleHost"/>
      <ComponentRef Id="FileAssociations"/><ComponentRef Id="UrlScheme"/>
      <ComponentRef Id="CommandLine"/><ComponentRef Id="CommandLineCmd"/><ComponentRef Id="WslWatcher"/>
      <ComponentRef Id="RemoteServerX64"/><ComponentRef Id="RemoteServerArm64"/>
      <ComponentRef Id="License"/><ComponentRef Id="Notice"/><ComponentRef Id="StartMenu"/>
      <ComponentRef Id="Icon_markdown"/><ComponentRef Id="Icon_json"/><ComponentRef Id="Icon_config"/><ComponentRef Id="Icon_markup"/><ComponentRef Id="Icon_style"/><ComponentRef Id="Icon_script"/><ComponentRef Id="Icon_table"/><ComponentRef Id="Icon_text"/><ComponentRef Id="Icon_javascript"/><ComponentRef Id="Icon_typescript"/><ComponentRef Id="Icon_python"/><ComponentRef Id="Icon_rust"/><ComponentRef Id="Icon_go"/><ComponentRef Id="Icon_c"/><ComponentRef Id="Icon_code"/><ComponentRef Id="Icon_project"/><ComponentRef Id="Icon_file"/>
    </Feature>
    <Feature Id="ContextMenu" Title="Explorer context menu" Level="1000">
      <Condition Level="1">WIX_UPGRADE_DETECTED</Condition>
      <ComponentRef Id="ContextMenu"/>
    </Feature>
    <Feature Id="FileTypes" Title="Associate file types" Level="1">
      <ComponentRef Id="FileTypeListing"/>
    </Feature>
  </Product>
</Wix>
