#!/usr/bin/env sh
# Starts winct from a shell. WSL finds this script through the Windows Path; winct receives the
# distribution so that absolute paths given here resolve inside it. --launcher lets winct.exe start its
# window in the background, so the command returns instead of waiting for winct to exit.
dir="$(dirname "$(dirname "$(realpath "$0")")")"
if [ -n "$WSL_DISTRO_NAME" ]; then
    exec "$dir/winct.exe" --launcher --wsl "$WSL_DISTRO_NAME" "$@"
fi
exec "$dir/winct.exe" --launcher "$@"
